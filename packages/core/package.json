{
  "name": "@rjvr/buzzsaw",
  "type": "module",
  "version": "3.1.0",
  "description": "Lightweight, zero-dependency Web Audio API sound synthesizer and sound management library",
  "author": "Ruandre Janse van Rensburg <ruandrejvr@gmail.com> (https://github.com/ruandre)",
  "license": "MIT",
  "homepage": "https://github.com/ruandre/buzzsaw/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruandre/buzzsaw.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ruandre/buzzsaw/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "audio",
    "web-audio",
    "sound-effects",
    "synthesizer",
    "sound-manager",
    "sfx",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sounds": {
      "types": "./dist/sounds.d.ts",
      "default": "./dist/sounds.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/testing"
  ],
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.build.json",
    "dev": "rolldown -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
