amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

// Tools resolve through mise (HK_MISE=1), so hooks use the versions pinned in mise.toml.

local linters = new Mapping<String, Step> {
  // antfu's config lints and formats TS/JS/Vue plus JSON, YAML, TOML, Markdown, CSS and HTML.
  ["eslint"] = (Builtins.eslint) {
    glob = List("**/*.{js,mjs,cjs,ts,mts,cts,vue,json,jsonc,yaml,yml,toml,md,css,html}")
    // Generated lockfiles: not linted, yet still trigger the verify steps below
    exclude = List("aube-lock.yaml", "mise.lock")
    // Staged ignored files (dist, generated) must not fail the hook on warnings
    check = "eslint --no-warn-ignored {{files}}"
    fix = "eslint --no-warn-ignored --fix {{files}}"
  }
}

// Manifests, lockfile and tsconfig included: dependency bumps can break types and tests without touching source
local verifyGlob = List(
  "**/*.{ts,vue}",
  "scripts/**/*.mjs",
  "**/package.json",
  "aube-lock.yaml",
  "mise.lock",
  "pnpm-workspace.yaml",
  "**/tsconfig*.json"
)

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ...linters
      // Resolves each pin through the GitHub API, so it runs only on staged workflow files (CI covers them all)
      ["pinact"] = Builtins.pinact
      // Whole workspace: an edit can break cross-file types or tests
      ["typecheck"] {
        glob = verifyGlob
        depends = "eslint"
        check = "mise run typecheck"
      }
      ["test"] {
        glob = verifyGlob
        depends = "eslint"
        check = "mise run test"
      }
    }
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  // Deferred to pre-push to keep local commits fast
  ["pre-push"] {
    steps {
      ["build"] {
        check = "mise run build"
        exclusive = true
      }
    }
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
