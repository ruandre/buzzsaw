{
  "name": "buzzsaw-monorepo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Sound effects described as data and synthesized in the browser.",
  "author": "Ruandre Janse van Rensburg <ruandrejvr@gmail.com> (https://github.com/ruandre)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruandre/buzzsaw.git"
  },
  "bugs": {
    "url": "https://github.com/ruandre/buzzsaw/issues"
  },
  "scripts": {
    "dev": "pnpm --filter @rjvr/buzzsaw-app dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:consumer": "docker compose -f test/consumer/compose.yaml run --rm verify",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status --since=origin/main"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-no-unsanitized": "catalog:",
    "eslint-plugin-security": "catalog:",
    "lefthook": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
